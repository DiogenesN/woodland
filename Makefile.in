CC = gcc
CFLAGS = -Wall -flto -Wextra -Wpedantic -march=native -funroll-loops -export-dynamic -fomit-frame-pointer
CFLAGS += -I/usr/include/dbus-1.0 -I/usr/lib/x86_64-linux-gnu/dbus-1.0/include
CFLAGS += -I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include
CFLAGS += -I/usr/include/librsvg-2.0 -I/usr/lib/x86_64-linux-gnu/librsvg-2.0/include
CFLAGS += -I/usr/include/cairo -I/usr/lib/x86_64-linux-gnu/cairo/include
CFLAGS += -I/usr/include/gdk-pixbuf-2.0 -I/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/include
CFLAGS += -I/usr/include/wlroots-0.18 -I/usr/lib/x86_64-linux-gnu/wlroots-0.18/include
LDFLAGS = -lm
LDFLAGS += $(shell pkg-config --libs stb cairo dbus-1 librsvg-2.0 wlroots-0.18 libinput pixman-1 xkbcommon wayland-server)
CFLAGS += $(shell pkg-config --cflags stb cairo dbus-1 librsvg-2.0 wlroots-0.18 libinput pixman-1 xkbcommon wayland-server)
CFLAGS += -Isrc/
CFLAGS += -DWLR_USE_UNSTABLE
SRCFILES = src/menu.c src/panel.c src/windowlist.c src/dbus-network-management.c src/getxkbkeyname.c src/getvaluefromconf.c src/runcmd.c src/woodland.c
OBJFILES = $(patsubst src/%.c, %.o, $(SRCFILES))
TARGET = woodland
PREFIX = /usr/local
BINDIR = $(PREFIX)/bin

all: $(TARGET)

$(TARGET): $(OBJFILES)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "\nSuccessfully built $(TARGET)!\nType 'make run' to test or 'sudo make install' to install."

%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

.PHONY: run

run: $(TARGET)
	@echo
	@echo "_________________________________________________________________________________________________________"
	@echo
	@echo "'"$(TARGET)"'" output is:
	@echo "_________________________________________________________________________________________________________"
	@echo
	sleep 1
	@./$(TARGET)

install: $(TARGET)
	install -d $(DESTDIR)$(BINDIR)
	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)

clean:
	rm -f $(OBJFILES) $(TARGET)

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(TARGET)

CC = gcc
CFLAGS = -Wall -flto -Wextra -Wpedantic -march=native -funroll-loops -export-dynamic -fomit-frame-pointer
CFLAGS += $(shell pkg-config --cflags dbus-1)
CFLAGS += $(shell pkg-config --cflags glib-2.0)
CFLAGS += $(shell pkg-config --cflags librsvg-2.0)
CFLAGS += $(shell pkg-config --cflags cairo)
CFLAGS += $(shell pkg-config --cflags gdk-pixbuf-2.0)
CFLAGS += $(shell pkg-config --cflags wlroots-0.18)
CFLAGS += $(shell pkg-config --cflags pixman-1)
CFLAGS += $(shell pkg-config --cflags libinput)
CFLAGS += $(shell pkg-config --cflags xkbcommon)
CFLAGS += $(shell pkg-config --cflags wayland-server)
CFLAGS += $(shell pkg-config --cflags stb)
CFLAGS += -Isrc
CFLAGS += -Iinclude
CFLAGS += -DWLR_USE_UNSTABLE
LDFLAGS = -lm
LDFLAGS += $(shell pkg-config --libs stb cairo dbus-1 librsvg-2.0 wlroots-0.18 libinput pixman-1 xkbcommon wayland-server)
SRCFILES = src/menu.c src/panel.c src/applauncher.c src/texttobuff.c src/generate-icon-cache.c src/windowlist.c src/dbus-network-management.c src/getxkbkeyname.c src/getvaluefromconf.c src/runcmd.c src/woodland.c
OBJFILES = $(patsubst src/%.c, %.o, $(SRCFILES))
TARGET = woodland
PREFIX = /usr/local
BINDIR = $(PREFIX)/bin

all: $(TARGET)

$(TARGET): $(OBJFILES)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "\nSuccessfully built $(TARGET)!\nType 'make run' to test or 'sudo make install' to install."

%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

.PHONY: run

run: $(TARGET)
	@echo
	@echo "_________________________________________________________________________________________________________"
	@echo
	@echo "'"$(TARGET)"'" output is:
	@echo "_________________________________________________________________________________________________________"
	@echo
	sleep 1
	@./$(TARGET)

install: $(TARGET)
	install -d $(DESTDIR)$(BINDIR)
	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)

clean:
	rm -f $(OBJFILES) $(TARGET)

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(TARGET)
